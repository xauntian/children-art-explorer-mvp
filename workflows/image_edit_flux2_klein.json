{
  "_meta": {
    "name": "FLUX.2 Klein 4B distilled reference image edit",
    "model_family": "flux2_klein",
    "source": "https://raw.githubusercontent.com/Comfy-Org/workflow_templates/main/templates/image_flux2_klein_image_edit_4b_distilled.json",
    "note": "Official single-reference edit architecture: image latent conditions both CFG branches; independent empty Flux2 target latent, dedicated Flux2 sigma scheduler, four distilled Euler steps. All nodes run locally."
  },
  "1": {"class_type": "LoadImage", "inputs": {"image": "__input_image__"}},
  "2": {"class_type": "UNETLoader", "inputs": {"unet_name": "__unet_name__", "weight_dtype": "default"}},
  "3": {"class_type": "CLIPLoader", "inputs": {"clip_name": "__text_encoder__", "type": "flux2", "device": "default"}},
  "4": {"class_type": "VAELoader", "inputs": {"vae_name": "__vae_name__"}},
  "5": {"class_type": "ImageScale", "inputs": {"image": ["1", 0], "upscale_method": "lanczos", "width": "__width__", "height": "__height__", "crop": "disabled"}},
  "6": {"class_type": "VAEEncode", "inputs": {"pixels": ["5", 0], "vae": ["4", 0]}},
  "7": {"class_type": "CLIPTextEncode", "inputs": {"text": "__positive_prompt__", "clip": ["3", 0]}},
  "8": {"class_type": "ConditioningZeroOut", "inputs": {"conditioning": ["7", 0]}},
  "9": {"class_type": "ReferenceLatent", "inputs": {"conditioning": ["7", 0], "latent": ["6", 0]}},
  "10": {"class_type": "ReferenceLatent", "inputs": {"conditioning": ["8", 0], "latent": ["6", 0]}},
  "11": {"class_type": "CFGGuider", "inputs": {"model": ["2", 0], "positive": ["9", 0], "negative": ["10", 0], "cfg": "__cfg__"}},
  "12": {"class_type": "EmptyFlux2LatentImage", "inputs": {"width": "__width__", "height": "__height__", "batch_size": 1}},
  "13": {"class_type": "RandomNoise", "inputs": {"noise_seed": "__seed__"}},
  "14": {"class_type": "KSamplerSelect", "inputs": {"sampler_name": "__sampler_name__"}},
  "15": {"class_type": "Flux2Scheduler", "inputs": {"steps": "__steps__", "width": "__width__", "height": "__height__"}},
  "16": {"class_type": "SamplerCustomAdvanced", "inputs": {"noise": ["13", 0], "guider": ["11", 0], "sampler": ["14", 0], "sigmas": ["15", 0], "latent_image": ["12", 0]}},
  "17": {"class_type": "VAEDecode", "inputs": {"samples": ["16", 0], "vae": ["4", 0]}},
  "18": {"class_type": "SaveImage", "inputs": {"images": ["17", 0], "filename_prefix": "__filename_prefix__"}}
}
